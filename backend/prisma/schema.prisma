generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  previewFeatures        = ["partialIndexes"]
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_events {
  id         String   @id @db.Uuid
  store_id   String   @db.Uuid
  actor_id   String?  @db.Uuid
  action     String
  entity_id  String?  @db.Uuid
  detail     Json     @default("{}")
  created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  stores     stores   @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([store_id, id])
  @@index([created_at(sort: Desc), id(sort: Desc)], map: "audit_events_platform", where: raw("(action ~~ 'PLATFORM\\_%'::text)"))
}

